{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Content manager",
      "type": "shell",
      "command": "python app.py",
      "options": { "cwd": "${workspaceFolder}/content-manager" },
      "isBackground": true,
      "presentation": { "group": "servers", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Public site",
      "type": "shell",
      "command": "python -m http.server 8000 --bind 127.0.0.1",
      "options": { "cwd": "${workspaceFolder}/public-site" },
      "isBackground": true,
      "presentation": { "group": "servers", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Table insights",
      "detail": "Local dashboard for transcript stats and the moments review (http://127.0.0.1:8002).",
      "type": "shell",
      "command": "python -I app.py",
      "options": { "cwd": "${workspaceFolder}/table-insights" },
      "isBackground": true,
      "presentation": { "group": "servers", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Run both",
      "dependsOn": ["Content manager", "Public site"],
      "problemMatcher": []
    },
    {
      "label": "Bot",
      "detail": "Discord bot (Vaultulation). Answer approvals here with y / n, in the dashboard or in the Windows dialog.",
      "type": "process",
      "command": "${workspaceFolder}/discord_server/bot/.venv/Scripts/python.exe",
      "args": ["run_bot.py"],
      "options": { "cwd": "${workspaceFolder}/discord_server/bot" },
      "isBackground": true,
      "presentation": { "group": "servers", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Bot + dashboard",
      "detail": "Discord bot, then opens its GM dashboard in the browser.",
      "type": "process",
      "command": "${workspaceFolder}/discord_server/bot/.venv/Scripts/python.exe",
      "args": ["run_bot.py", "--open-dashboard"],
      "options": { "cwd": "${workspaceFolder}/discord_server/bot" },
      "isBackground": true,
      "presentation": { "group": "servers", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Open site and manager",
      "detail": "Opens the Nowhere Expeditions desktop app (or, without it, the pages in the browser).",
      "type": "process",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/start-everything.ps1", "-OpenOnly"],
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Everything",
      "detail": "Content manager, public site, table insights, bot + dashboard, all shown in the desktop app.",
      "dependsOn": ["Content manager", "Public site", "Table insights", "Bot + dashboard", "Open site and manager"],
      "problemMatcher": []
    }
  ]
}
