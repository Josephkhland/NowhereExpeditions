     "author_id": "900000000000000005",
     "author": "Juniper",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "\"Quiet. Everyone.\" *Dagny rings the Echo Bell once and lifts the Listening Horn.*",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
