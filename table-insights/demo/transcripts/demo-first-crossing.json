   "truncated": false,
   "messages": [
    {
     "invoked_by": null,
     "id": "910000000000000001",
     "time": "2026-10-03T17:00:00+00:00",
     "edited": null,
     "author_id": "900000000000000001",
     "author": "Narrator",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "*The Job Board notice is pinned with a bent nail: SURVEY BEYOND THE GATE. RETURN BY DARK. PAY ON DELIVERY OF SAMPLES.* The crew gathers at the Outpost gate at first light. What do you bring?",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000002",
     "time": "2026-10-03T17:03:00+00:00",
     "edited": null,
     "author_id": "900000000000000002",
     "author": "Wren",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "*Checks the Rope twice, then a third time out of spite.* \"Rope, Grappling Kit, and my own two hands. That's the whole plan.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000003",
     "time": "2026-10-03T17:05:00+00:00",
     "edited": null,
     "author_id": "900000000000000003",
     "author": "Bolt",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "\"I've brought a Lantern, a Flare Pistol and an excellent attitude.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000004",
     "time": "2026-10-03T17:07:00+00:00",
     "edited": null,
     "author_id": "900000000000000004",
     "author": "Moss",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "*Pell has a Rations Kit strapped to each shoulder.* \"I packed rations for five. Do not ask me why there are five.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000005",
     "time": "2026-10-03T17:08:00+00:00",
     "edited": null,
     "author_id": "900000000000000006",
     "author": "Kit",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "\"There are five of us, Pell.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": [
      {
       "emoji": "😂",
       "count": 3
      }
     ]
    },
    {
     "invoked_by": null,
     "id": "910000000000000006",
     "time": "2026-10-03T17:09:00+00:00",
     "edited": null,
     "author_id": "900000000000000004",
     "author": "Moss",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "\"...Right. Yes. That was the plan all along.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000007",
     "time": "2026-10-03T17:12:00+00:00",
     "edited": null,
     "author_id": "900000000000000005",
     "author": "Juniper",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "*Dagny shoulders the Echo Bell and a Listening Horn.* \"If anything down there sings, I want to hear it first.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000008",
     "time": "2026-10-03T17:14:00+00:00",
     "edited": null,
     "author_id": "900000000000000006",
     "author": "Kit",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "*Mei unrolls a Tide Chart and a blank page of the field notebook.* \"I'll map. Somebody has to write down where we nearly died.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000009",
     "time": "2026-10-03T17:16:00+00:00",
     "edited": null,
     "author_id": "900000000000000001",
     "author": "Narrator",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "\"Good. The Gate opens at the turn of the tide. Anyone want to check the weather before you go?\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000010",
     "time": "2026-10-03T17:18:00+00:00",
     "edited": null,
     "author_id": "900000000000000006",
     "author": "Kit",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "\"The Portable Barometer, please. I want to know if the air on the other side is lying to us.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": "Kit",
     "id": "910000000000000011",
     "time": "2026-10-03T17:19:00+00:00",
     "edited": null,
     "author_id": "900000000000000099",
     "author": "Dice Maiden",
     "bot": true,
     "webhook": true,
     "type": "MessageType.chat_input_command",
     "content": "Mei (Kit) Request: `[4dF+2]` Result: `4` Reason: `Notice`",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000012",
     "time": "2026-10-03T17:21:00+00:00",
     "edited": null,
     "author_id": "900000000000000001",
     "author": "Narrator",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "*The needle shivers, then drops. Pressure falls fast on the far side: a storm, or something breathing.* You get the aspect **Pressure Falling**.",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000013",
     "time": "2026-10-03T17:22:00+00:00",
     "edited": null,
     "author_id": "900000000000000002",
     "author": "Wren",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "\"Lovely. A storm or a monster. My two favourite surprises.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000014",
     "time": "2026-10-03T17:23:00+00:00",
     "edited": null,
     "author_id": "900000000000000003",
     "author": "Bolt",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "\"Statistically one of those is fine.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000015",
     "time": "2026-10-03T17:24:00+00:00",
     "edited": null,
     "author_id": "900000000000000005",
     "author": "Juniper",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "\"Statistically you've never been right about anything.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": [
