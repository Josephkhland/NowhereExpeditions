     "author_id": "900000000000000005",
     "author": "Juniper",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "\"Something down there rang back before the bell finished. I'm writing that down and then I'm never thinking about it again.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
