     "author_id": "900000000000000001",
     "author": "Narrator",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "*Beyond the Gate the ground slopes down into a basin of black glass. Wind moves over it with a sound like breath through teeth. Halfway down, the path ends in a drop.*",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
     "invoked_by": null,
     "id": "910000000000000018",
     "time": "2026-10-03T17:57:00+00:00",
     "edited": null,
     "author_id": "900000000000000002",
     "author": "Wren",
     "bot": false,
     "webhook": false,
     "type": "MessageType.default",
     "content": "\"I'll anchor a line. Nobody step anywhere until I say so.\"",
     "reply_to": null,
     "attachments": [],
     "embeds": [],
     "thread": null,
     "reactions": []
    },
    {
