# Generated by the content manager's "Export to site"; the live site is deployed from public-site/ instead.
site-export/

# The content manager's database holds unpublished GM material. Never commit it
# (content-manager/.gitignore also excludes it). Back it up somewhere private.
*.db
*.db-shm
*.db-wal

# Full-size source artwork (e.g. the original logos); the site uses resized copies in public-site/assets/images/.
artwork/

# Python caches
__pycache__/
*.py[cod]

# OS and editor clutter
.DS_Store
Thumbs.db
desktop.ini

# Written by the deploy workflow (.github/scripts/release_version.py); never committed.
public-site/version.json

# Lore entry drafts (nowhere-lore-writer skill); the content manager database is the source of truth.
lore/

# Recruitment and hype posts (drafts and an archive of what was posted). Kept out of the public repo.
marketing_promotion/

# Personal Claude Code settings (deny rules protecting the Discord bot token).
.claude/settings.local.json
# Skill for the private Discord bot (lives with discord_server/, kept out of the public repo).
.claude/skills/vaultulation-bot/

# Discord server planning and moderation notes. Kept out of the public repo,
# except the bot's code (discord_server/bot/ has its own .gitignore for the venv and secrets).
discord_server/*
!discord_server/bot/
