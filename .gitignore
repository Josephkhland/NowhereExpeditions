# Generated by the content manager's "Export to site"; the live site is deployed from public-site/ instead.
site-export/

# The content manager's database holds unpublished GM material. Never commit it
# (content-manager/.gitignore also excludes it). Back it up somewhere private.
*.db
*.db-shm
*.db-wal

# Full-size source artwork (e.g. the original logos); the site uses resized copies in public-site/assets/images/.
artwork/

# Python caches
__pycache__/
*.py[cod]

# OS and editor clutter
.DS_Store
Thumbs.db
desktop.ini

# Written by the deploy workflow (.github/scripts/release_version.py); never committed.
public-site/version.json

# Lore entry drafts (nowhere-lore-writer skill); the content manager database is the source of truth.
lore/
